                <field id="key_secret" translate="label" type="obscure" sortOrder="40" showInDefault="1" showInWebsite="1" showInStore="0"><label>Key Secret</label><backend_model>Magento\Config\Model\Config\Backend\Encrypted</backend_model></field>
